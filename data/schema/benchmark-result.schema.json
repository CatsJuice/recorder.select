{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recorder.select/schema/benchmark-result.schema.json",
  "title": "RecorderBench result",
  "type": "object",
  "required": ["schemaVersion", "id", "scenario", "startedAt", "endedAt", "target", "machine", "sampleIntervalSeconds", "summary", "samples"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "format": "uuid" },
    "scenario": { "enum": ["recording", "preview", "export"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "sampleIntervalSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "mediaDurationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "notes": { "type": ["string", "null"] },
    "target": {
      "type": "object",
      "required": ["recorderID", "name", "bundlePath"],
      "properties": {
        "recorderID": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "bundleIdentifier": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "bundlePath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "machine": {
      "type": "object",
      "required": ["model", "processor", "memoryBytes", "logicalCoreCount", "operatingSystem", "toolVersion"],
      "properties": {
        "model": { "type": "string" },
        "processor": { "type": "string" },
        "memoryBytes": { "type": "integer", "minimum": 0 },
        "logicalCoreCount": { "type": "integer", "minimum": 1 },
        "operatingSystem": { "type": "string" },
        "toolVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["durationSeconds", "averageCPUPercent", "p95CPUPercent", "peakCPUPercent", "averageSystemCPUPercent", "p95SystemCPUPercent", "peakSystemCPUPercent", "cpuTimeSeconds", "averagePhysicalFootprintBytes", "peakPhysicalFootprintBytes", "physicalFootprintDeltaBytes", "peakProcessCount", "diskReadBytes", "diskWrittenBytes"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 0 },
        "averageCPUPercent": { "type": "number", "minimum": 0 },
        "p95CPUPercent": { "type": "number", "minimum": 0 },
        "peakCPUPercent": { "type": "number", "minimum": 0 },
        "averageSystemCPUPercent": { "type": "number", "minimum": 0 },
        "p95SystemCPUPercent": { "type": "number", "minimum": 0 },
        "peakSystemCPUPercent": { "type": "number", "minimum": 0 },
        "cpuTimeSeconds": { "type": "number", "minimum": 0 },
        "averagePhysicalFootprintBytes": { "type": "integer", "minimum": 0 },
        "peakPhysicalFootprintBytes": { "type": "integer", "minimum": 0 },
        "physicalFootprintDeltaBytes": { "type": "integer" },
        "peakProcessCount": { "type": "integer", "minimum": 0 },
        "diskReadBytes": { "type": "integer", "minimum": 0 },
        "diskWrittenBytes": { "type": "integer", "minimum": 0 },
        "realtimeFactor": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["elapsedSeconds", "cpuPercent", "systemCPUPercent", "physicalFootprintBytes", "diskReadBytes", "diskWrittenBytes", "processes"],
        "properties": {
          "elapsedSeconds": { "type": "number", "minimum": 0 },
          "cpuPercent": { "type": "number", "minimum": 0 },
          "systemCPUPercent": { "type": "number", "minimum": 0 },
          "physicalFootprintBytes": { "type": "integer", "minimum": 0 },
          "diskReadBytes": { "type": "integer", "minimum": 0 },
          "diskWrittenBytes": { "type": "integer", "minimum": 0 },
          "processes": { "type": "array" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
